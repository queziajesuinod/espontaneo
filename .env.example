# ---------- desenvolvimento ----------
# banco local: `pnpm banco:up` sobe o Postgres em localhost:5433
DATABASE_URL=postgres://espontaneo:espontaneo@localhost:5433/espontaneo
PORT=3335

# segredos — TROQUE em produção (gere com: openssl rand -hex 32)
SESSION_SECRET=dev-inseguro-troque
IP_SALT=dev-salt

# admin inicial (criado pelo `pnpm semear`)
ADMIN_EMAIL=admin@espontaneo.local
ADMIN_SENHA=espontaneo

# opcionais
TURNSTILE_SECRET=
ACERVO_DIR=./.acervo

# ---------- produção (docker compose / Portainer) ----------
# em produção, DATABASE_URL aponta para o Postgres que já existe na VPS:
#   postgres://usuario:senha@nome-do-container:5432/espontaneo
# porta do site na VPS (troque se a 80 já estiver ocupada, ex.: pelo próprio Portainer)
WEB_PORT=80
# NODE_ENV=production exige HTTPS (cookie "secure"). Para testar em http://IP, use development.
NODE_ENV=production

# só para o Postgres LOCAL de dev (docker-compose.dev.yml)
POSTGRES_PASSWORD=espontaneo
